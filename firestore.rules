rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// All collections are subcollections of users/{userId}:
//
// Collection: transactions
// Fields:
//   - description: string (required, 1-200 chars)
//   - amount: number (required, > 0)
//   - type: string (required, enum: "expense" | "income")
//   - category: string (optional, 0-50 chars)
//   - createdAt: timestamp (required, immutable, auto-set)
//   - updatedAt: timestamp (required, auto-set)
//   - transactionDate: timestamp (optional, user-selected date)
//   - recurringId: string (optional, 0-50 chars)
//   - recurringPeriod: string (optional, 0-20 chars)
//
// Collection: categories
// Fields:
//   - name: string (required, 1-50 chars)
//   - monthlyBudget: number (required, >= 0)
//   - createdAt: timestamp (required, immutable, auto-set)
//   - updatedAt: timestamp (required, auto-set)
//
// Collection: recurringTransactions
// Fields:
//   - description: string (required, 1-200 chars)
//   - amount: number (required, > 0)
//   - type: string (required, enum: "expense" | "income")
//   - category: string (optional, 0-50 chars)
//   - dayOfMonth: number (required, 1-28)
//   - createdAt: timestamp (required, immutable, auto-set)
//
// Collection: goals
// Fields:
//   - name: string (required, 1-100 chars)
//   - targetAmount: number (required, > 0)
//   - targetDate: timestamp (optional)
//   - currentAmount: number (required, >= 0)
//   - contributions: array (optional, [{amount, addedAt}])
//   - createdAt: timestamp (required, immutable, auto-set)
//   - updatedAt: timestamp (required, auto-set)
//
// Collection: assets
// Fields:
//   - name: string (required, 1-100 chars)
//   - amount: number (required, > 0)
//   - createdAt: timestamp (required, immutable, auto-set)
//
// Collection: liabilities
// Fields:
//   - name: string (required, 1-100 chars)
//   - amount: number (required, > 0)
//   - createdAt: timestamp (required, immutable, auto-set)
//
// Collection: subscriptions
// Fields:
//   - name: string (required, 1-100 chars)
//   - amount: number (required, > 0)
//   - frequency: string (required, enum: "monthly" | "yearly" | "weekly")
//   - nextDate: timestamp (optional)
//   - createdAt: timestamp (required, immutable, auto-set)
//
// ===============================================================

// ===============================================================
// Helper Functions
// ===============================================================

function isAuthenticated() {
  return request.auth != null;
}

function isOwner(userId) {
  return isAuthenticated() && request.auth.uid == userId;
}

function isExistingDoc() {
  return resource != null && resource.data != null;
}

// Number validation
function isPositiveNumber(field) {
  return field is number && field > 0;
}

function isNonNegativeNumber(field) {
  return field is number && field >= 0;
}

function isNumberInRange(field, min, max) {
  return field is number && field >= min && field <= max;
}

// String validation
function isValidString(field, minLen, maxLen) {
  return field is string && field.size() >= minLen && field.size() <= maxLen;
}

function isValidOptionalString(field, maxLen) {
  return !(field in request.resource.data) ||
         (request.resource.data[field] is string &&
          request.resource.data[field].size() <= maxLen);
}

// Enum validation
function isValidType() {
  return request.resource.data.type in ['expense', 'income'];
}

function isValidFrequency() {
  return request.resource.data.frequency in ['monthly', 'yearly', 'weekly'];
}

// Immutable field protection
function createdAtUnchanged() {
  return request.resource.data.createdAt == resource.data.createdAt;
}

// Do not allow extra fields beyond the defined schema
function hasOnlyAllowedFields(fields) {
  return request.resource.data.keys().hasOnly(fields);
}

// ===============================================================
// Collection Validators
// ===============================================================

function isValidTransaction(data) {
  return hasOnlyAllowedFields(['description', 'amount', 'type', 'category', 'transactionDate', 'createdAt', 'updatedAt', 'recurringId', 'recurringPeriod']) &&
         isValidString(data.description, 1, 200) &&
         isPositiveNumber(data.amount) &&
         isValidType() &&
         isValidOptionalString('category', 50) &&
         isValidOptionalString('recurringId', 50) &&
         isValidOptionalString('recurringPeriod', 20) &&
         data.createdAt is timestamp &&
         (!('transactionDate' in data) || data.transactionDate is timestamp);
}

// For CREATE, createdAt is serverTimestamp() sentinel (null during rules eval)
// ServerTimestamp guarantees the stored value will be a server-side timestamp.
function isValidTransactionCreate(data) {
  return hasOnlyAllowedFields(['description', 'amount', 'type', 'category', 'transactionDate', 'createdAt', 'updatedAt', 'recurringId', 'recurringPeriod']) &&
         isValidString(data.description, 1, 200) &&
         isPositiveNumber(data.amount) &&
         isValidType() &&
         isValidOptionalString('category', 50) &&
         isValidOptionalString('recurringId', 50) &&
         isValidOptionalString('recurringPeriod', 20) &&
         (!('transactionDate' in data) || data.transactionDate is timestamp);
}

function isValidCategory(data) {
  return hasOnlyAllowedFields(['name', 'monthlyBudget', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 50) &&
         isNonNegativeNumber(data.monthlyBudget) &&
         data.createdAt is timestamp;
}

function isValidCategoryCreate(data) {
  return hasOnlyAllowedFields(['name', 'monthlyBudget', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 50) &&
         isNonNegativeNumber(data.monthlyBudget);
}

function isValidRecurringTransaction(data) {
  return hasOnlyAllowedFields(['description', 'amount', 'type', 'category', 'dayOfMonth', 'createdAt', 'updatedAt']) &&
         isValidString(data.description, 1, 200) &&
         isPositiveNumber(data.amount) &&
         isValidType() &&
         isValidOptionalString('category', 50) &&
         isNumberInRange(data.dayOfMonth, 1, 28) &&
         data.createdAt is timestamp;
}

function isValidRecurringTransactionCreate(data) {
  return hasOnlyAllowedFields(['description', 'amount', 'type', 'category', 'dayOfMonth', 'createdAt', 'updatedAt']) &&
         isValidString(data.description, 1, 200) &&
         isPositiveNumber(data.amount) &&
         isValidType() &&
         isValidOptionalString('category', 50) &&
         isNumberInRange(data.dayOfMonth, 1, 28);
}

function isValidGoal(data) {
  return hasOnlyAllowedFields(['name', 'targetAmount', 'targetDate', 'currentAmount', 'contributions', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.targetAmount) &&
         isNonNegativeNumber(data.currentAmount) &&
         (!('targetDate' in data) || data.targetDate is timestamp) &&
         data.createdAt is timestamp;
}

function isValidGoalCreate(data) {
  return hasOnlyAllowedFields(['name', 'targetAmount', 'targetDate', 'currentAmount', 'contributions', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.targetAmount) &&
         isNonNegativeNumber(data.currentAmount) &&
         (!('targetDate' in data) || data.targetDate is timestamp);
}

function isValidAsset(data) {
  return hasOnlyAllowedFields(['name', 'amount', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.amount) &&
         data.createdAt is timestamp;
}

function isValidAssetCreate(data) {
  return hasOnlyAllowedFields(['name', 'amount', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.amount);
}

function isValidLiability(data) {
  return hasOnlyAllowedFields(['name', 'amount', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.amount) &&
         data.createdAt is timestamp;
}

function isValidLiabilityCreate(data) {
  return hasOnlyAllowedFields(['name', 'amount', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.amount);
}

function isValidSubscription(data) {
  return hasOnlyAllowedFields(['name', 'amount', 'frequency', 'nextDate', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.amount) &&
         isValidFrequency() &&
         (!('nextDate' in data) || data.nextDate is timestamp) &&
         data.createdAt is timestamp;
}

function isValidSubscriptionCreate(data) {
  return hasOnlyAllowedFields(['name', 'amount', 'frequency', 'nextDate', 'createdAt', 'updatedAt']) &&
         isValidString(data.name, 1, 100) &&
         isPositiveNumber(data.amount) &&
         isValidFrequency() &&
         (!('nextDate' in data) || data.nextDate is timestamp);
}

// ===============================================================
// Rules
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // All user data is under users/{userId}
    match /users/{userId} {

      // Prevent direct access to the user document itself
      allow read, write: if false;

      // --- transactions ---
      match /transactions/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidTransactionCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidTransaction(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // --- categories ---
      match /categories/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidCategoryCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidCategory(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // --- recurringTransactions ---
      match /recurringTransactions/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidRecurringTransactionCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidRecurringTransaction(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // --- goals ---
      match /goals/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidGoalCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidGoal(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // --- assets ---
      match /assets/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidAssetCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidAsset(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // --- liabilities ---
      match /liabilities/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidLiabilityCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidLiability(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // --- subscriptions ---
      match /subscriptions/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidSubscriptionCreate(request.resource.data);
        allow update: if isOwner(userId) &&
          isExistingDoc() &&
          isValidSubscription(request.resource.data) &&
          createdAtUnchanged();
        allow delete: if isOwner(userId) && isExistingDoc();
      }

      // Deny anything else under users/{userId}
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Deny everything outside users/{userId}
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
